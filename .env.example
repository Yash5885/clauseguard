# Server
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Local PostgreSQL started by compose.yaml
DATABASE_URL=postgresql://clauseguard:clauseguard@localhost:5432/clauseguard

# Reserved for later build steps. Keep secrets only in .env, never in git.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

# Clerk managed authentication. Never expose CLERK_SECRET_KEY to Vite.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

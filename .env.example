# Server
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Local PostgreSQL started by compose.yaml
DATABASE_URL=postgresql://clauseguard:clauseguard@localhost:5432/clauseguard

# Google Gemini embeddings. Keep secrets only in .env, never in git.
GEMINI_API_KEY=
# Uploaded clauses must use this same model and the code's 768 dimensions.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Stable structured-output model used to segment extracted contract text.
GEMINI_SEGMENTATION_MODEL=gemini-3.5-flash

# Clerk managed authentication. Never expose CLERK_SECRET_KEY to Vite.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

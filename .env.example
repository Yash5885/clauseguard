# Clause Guard environment template
# Copy this file to .env for local development. In production, enter the
# frontend variables in Vercel and the backend variables in Render/Railway.

# ---------------------------------------------------------------------------
# Frontend (Vercel build-time variables; VITE_ values are public in the bundle)
# ---------------------------------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=
# Backend origin only, with no trailing slash or /api suffix.
VITE_API_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Backend (Render or Railway runtime variables)
# ---------------------------------------------------------------------------
NODE_ENV=development
# Render/Railway inject PORT automatically. This value is for local use.
PORT=3000
# Exact frontend origins, comma-separated. Never use * for the authenticated API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL with pgvector. Use the platform's private/internal URL when the API
# and database are on the same provider/project.
DATABASE_URL=postgresql://clauseguard:clauseguard@localhost:5432/clauseguard
# Set true only when the managed connection requires TLS (commonly public URLs).
DATABASE_SSL=false

# Clerk managed authentication. Keep the secret key on the backend only.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Google Gemini. Keep this API key on the backend only.
GEMINI_API_KEY=
# Uploaded and baseline clauses must use the same 768-dimensional model.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Structured-output models for segmentation and grounded explanations.
GEMINI_SEGMENTATION_MODEL=gemini-3.5-flash
GEMINI_EXPLANATION_MODEL=gemini-3.5-flash
# Used for transient capacity/rate-limit failures from the primary model.
GEMINI_GENERATION_FALLBACK_MODEL=gemini-3.1-flash-lite
